<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#F0141416" android:endColor="#F00A0A0C" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#35FF8A00" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
