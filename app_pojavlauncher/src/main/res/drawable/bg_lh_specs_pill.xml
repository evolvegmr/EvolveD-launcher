<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark-graphite glass surface for Home screen profile specs pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E6191712"
                android:endColor="#E6100F0C" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#38352A1B" />
        </shape>
    </item>
</layer-list>
