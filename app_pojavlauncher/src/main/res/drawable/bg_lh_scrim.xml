<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen legibility treatment over the instance artwork:
     1. vertical depth (light top → heavy bottom) for the library band,
     2. left anchor so the 3D player separates cleanly from the scene,
     3. soft right veil so the launch cluster stays readable.
     Atmosphere without competing with the UI. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#66050505"
                android:centerColor="#5C050505"
                android:endColor="#F2050505" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#B0050505"
                android:centerColor="#4D050505"
                android:endColor="#14050505" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="180"
                android:startColor="#66050505"
                android:centerColor="#26050505"
                android:endColor="#00050505" />
        </shape>
    </item>
</layer-list>
